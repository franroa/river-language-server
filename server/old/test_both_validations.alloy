// Comprehensive test for BOTH validations

// ❌ Should show MAP COMMA errors (missing commas on each property line)
prometheus.remote_write "comma_errors" {
	endpoint {
		url = "http://localhost:9090/api/v1/push"
	}
	
	external_labels = {
		instance = "local"        // ERROR: Missing comma
		env = "production"        // ERROR: Missing comma  
	}
}

// ❌ Should show UNKNOWN BLOCK errors (basic_auth not valid for remote_write)
prometheus.remote_write "block_errors" {
	endpoint {
		url = "http://localhost:9090/api/v1/push"
	}
	
	basic_auth {                  // ERROR: Unknown block
		username = "user",
		password = "pass",
	}
}

// ✅ Should be completely valid
prometheus.remote_write "valid" {
	endpoint {
		url = "http://localhost:9090/api/v1/push"
	}
	
	wal {
		retention = "1h"
	}
	
	external_labels = {
		instance = "local",       // ✅ Has comma
		env = "production",       // ✅ Has comma  
	}
}