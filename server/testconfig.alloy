livedebugging {
	enabled = true
}

local.file_match "app_logs" {
	path_targets = [{"__path__" = "test"}]
}

loki.source.file "read_logs" {
	targets    = local.file_match.app_logs.targets
	forward_to = [loki.relabel.test.receiver]
}

     loki.relabel "test" {
      forward_to = [loki.write.to_loki.receiver]
      rule {
        source_labels = ["filename"]
        regex = "(.*)"
        target_label = "path"
        action = "replace"
      }
     }

loki.write "to_loki" {
	endpoint {
		url = "http://dummy/loki/api/v1/push"
	}
}

     
