{
  "name": "otelcol.exporter.faro",
  "usage": "otelcol.exporter.faro \"<LABEL>\" {\n    client {\n        endpoint = \"<HOST>:<PORT>\"\n    }\n}",
  "arguments": [],
  "blocks": [
    {
      "block": "client",
      "description": "Configures the HTTP client to send telemetry data to.",
      "required": true,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#client"
    },
    {
      "block": "client > compression_params",
      "description": "Configure advanced compression options.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#compression_params"
    },
    {
      "block": "client > cookies",
      "description": "Store cookies from server responses and reuse them in subsequent requests.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#cookies"
    },
    {
      "block": "client > tls",
      "description": "Configures TLS for the HTTP client.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#tls"
    },
    {
      "block": "client > tls > tpm",
      "description": "Configures TPM settings for the TLS key_file.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#tpm"
    },
    {
      "block": "debug_metrics",
      "description": "Configures the metrics that this component generates to monitor its state.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#debug_metrics"
    },
    {
      "block": "retry_on_failure",
      "description": "Configures retry mechanism for failed requests.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#retry_on_failure"
    },
    {
      "block": "sending_queue",
      "description": "Configures batching of data before sending.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.faro/#sending_queue"
    }
  ],
  "exported_fields": [
    {
      "name": "input",
      "type": "otelcol.Consumer",
      "description": "A value that other components can use to send telemetry data to."
    }
