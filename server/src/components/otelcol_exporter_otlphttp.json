{
  "name": "otelcol.exporter.otlphttp",
  "usage": "otelcol.exporter.otlphttp \"<LABEL>\" {\n  client {\n    endpoint = \"<HOST>:<PORT>\"\n  }\n}",
  "arguments": [
    {
      "name": "encoding",
      "type": "string",
      "description": "The encoding to use for messages. Should be either \"proto\" or \"json\".",
      "default": "\"proto\"",
      "required": false
    },
    {
      "name": "logs_endpoint",
      "type": "string",
      "description": "The endpoint to send logs to.",
      "default": "client.endpoint + \"/v1/logs\"",
      "required": false
    },
    {
      "name": "metrics_endpoint",
      "type": "string",
      "description": "The endpoint to send metrics to.",
      "default": "client.endpoint + \"/v1/metrics\"",
      "required": false
    },
    {
      "name": "traces_endpoint",
      "type": "string",
      "description": "The endpoint to send traces to.",
      "default": "client.endpoint + \"/v1/traces\"",
      "required": false
    }
  ],
  "blocks": [
    {
      "block": "client",
      "description": "Configures the HTTP client to send telemetry data to.",
      "required": true,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#client"
    },
    {
      "block": "client > compression_params",
      "description": "Configure advanced compression options.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#compression_params"
    },
    {
      "block": "client > cookies",
      "description": "Store cookies from server responses and reuse them in subsequent requests.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#cookies"
    },
    {
      "block": "client > tls",
      "description": "Configures TLS for the HTTP client.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#tls"
    },
    {
      "block": "client > tls > tpm",
      "description": "Configures TPM settings for the TLS key_file.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#tpm"
    },
    {
      "block": "debug_metrics",
      "description": "Configures the metrics that this component generates to monitor its state.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#debug_metrics"
    },
    {
      "block": "retry_on_failure",
      "description": "Configures retry mechanism for failed requests.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#retry_on_failure"
    },
    {
      "block": "sending_queue",
      "description": "Configures batching of data before sending.",
      "required": false,
      "url": "https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#sending_queue"
    }
  ],
  "exported_fields": [
    {
      "name": "input",
      "type": "otelcol.Consumer",
      "description": "A value that other components can use to send telemetry data to."
    }
  ],
