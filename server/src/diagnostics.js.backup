            (value.startsWith("'") && value.endsWith("'"))) {
            return 'string';
        }

        // Numbers
        if (/^\d+$/.test(value)) {
            return 'number';
        }

        if (/^\d+\.\d+$/.test(value)) {
            return 'number';
        }

        // Booleans
        if (value === 'true' || value === 'false') {
            return 'bool';
        }

        // Durations
        if (/^\d+[smhd]$/.test(value)) {
            return 'duration';
        }

        // Lists
        if (value.startsWith('[') && value.endsWith(']')) {
            return 'list';
        }

        // Maps/Objects
        if (value.startsWith('{') && value.endsWith('}')) {
            return 'map';
        }

        // Component references (like prometheus.scrape.default.receiver)
        if (/^\w+\.\w+\.\w+\.\w+$/.test(value)) {
            return 'component_reference';
        }

