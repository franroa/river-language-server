        if (value.startsWith('argument.') && value.endsWith('.value')) {
            return 'argument_reference';
        }

        // Declared component references (like component.label.field)
        if (/^\w+\.\w+\.\w+$/.test(value)) {
            return 'declared_component_reference';
        }

        // If we can't infer the type, return null (this will trigger a warning)
        return null;
    }

