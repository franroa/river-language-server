        if (!listContent.startsWith('[') || !listContent.endsWith(']')) {
            return false;
        }

        // Handle empty list
        const innerContent = listContent.slice(1, -1).trim();
        if (innerContent === '') {
            return true; // Empty list is valid for any list type
        }

        // Simple parsing for testing - split by comma
        const elements = innerContent.split(',').map(e => e.trim());

        // Validate each element
        for (const element of elements) {
            if (!this.validateListElement(element, expectedElementType)) {
                return false;
            }
        }

        return true;
    }

    /**
     * Validate a single list element against the expected type
     */
    validateListElement(element, expectedType) {
        const trimmedElement = element.trim();

        // Handle receiver elements - enhanced validation (receiver, LogsReceiver, MetricsReceiver)
        if (expectedType === 'receiver' || expectedType === 'LogsReceiver' || expectedType === 'MetricsReceiver') {
            // Reject empty strings and simple string literals
            if ((trimmedElement.startsWith('"') && trimmedElement.endsWith('"')) ||
                (trimmedElement.startsWith("'") && trimmedElement.endsWith("'"))) {
                return false; // String literals are not valid receivers
            }

            // Allow component references like prometheus.remote_write.default.receiver
            if (/^\w+\.\w+\.\w+\.\w+$/.test(trimmedElement)) {
                return true;
            }

            // Allow argument references
            if (trimmedElement.startsWith('argument.') && trimmedElement.endsWith('.value')) {
                return true;
            }

            // Allow declared component references (component_name.label.exported_field)
            if (/^\w+\.\w+\.\w+$/.test(trimmedElement)) {
                return true;
            }

            // Reject anything else for receiver types
            return false;
        }

        // Handle string elements
        if (expectedType === 'string') {
            return (trimmedElement.startsWith('"') && trimmedElement.endsWith('"')) ||
                   (trimmedElement.startsWith("'") && trimmedElement.endsWith("'"));
        }

        // For other types, accept any non-empty value for now
        return trimmedElement.length > 0;
    }
}
/**
 * Validate duplicates within a single document (components and config blocks)
 */
function validateDuplicatesWithinDocument(parsedComponents, parsedConfigBlocks) {
    const diagnostics = [];
    // Track component instances by type + label
    const componentTracker = {};
    // Track config blocks by type + label
    const configBlockTracker = {};
    // Collect all components (including those from root and declare blocks)
    for (const component of parsedComponents) {
        if (component.label) {
            // Include scope in the key to separate components in different scopes
            const scope = component.scope || 'root';
            const key = `${scope}:${component.name}:${component.label}`;
            if (!componentTracker[key]) {
                componentTracker[key] = [];
            }
            componentTracker[key].push(component);
        }
    }
    
    // Also collect components from inside declare blocks
    for (const configBlock of parsedConfigBlocks) {
        if (configBlock.components) {
            for (const component of configBlock.components) {
                if (component.label) {
                    // Include scope in the key to separate components in different scopes
                    const scope = component.scope || 'root';
                    const key = `${scope}:${component.name}:${component.label}`;
                    if (!componentTracker[key]) {
                        componentTracker[key] = [];
                    }
                    componentTracker[key].push(component);
                }
            }
        }
    }
    // Collect all config blocks (including declare blocks)
    for (const configBlock of parsedConfigBlocks) {
        if (configBlock.label) {
            const key = `${configBlock.type}:${configBlock.label}`;
            if (!configBlockTracker[key]) {
                configBlockTracker[key] = [];
            }
            configBlockTracker[key].push(configBlock);
        }
    }
    // Report duplicates for components
    for (const [key, occurrences] of Object.entries(componentTracker)) {
        if (occurrences.length > 1) {
            const [scope, componentType, label] = key.split(':');
            const scopeLabel = scope === 'root' ? 'root scope' : `declare block '${scope}'`;
            for (const occurrence of occurrences) {
                diagnostics.push({
                    severity: node_1.DiagnosticSeverity.Error,
                    range: occurrence.range,
                    message: `Duplicate component '${componentType}' with label '${label}' in ${scopeLabel}. Found ${occurrences.length} instances.`,
                    source: "alloy-lsp",
                });
            }
        }
    }
    // Report duplicates for config blocks
    for (const [key, occurrences] of Object.entries(configBlockTracker)) {
        if (occurrences.length > 1) {
            const [blockType, label] = key.split(':');
            for (const occurrence of occurrences) {
                diagnostics.push({
                    severity: node_1.DiagnosticSeverity.Error,
                    range: occurrence.range,
                    message: `Duplicate ${blockType} block with label '${label}'. Found ${occurrences.length} instances in this document.`,
                    source: "alloy-lsp",
                });
            }
        }
    }
    return diagnostics;
}
async function getDocumentDiagnostics(document, documents, workspaceComponentLabelMap, allComponentData) {
    try {
        // Use provided component data, or get all component data including declared components - use workspace if available
        const componentData = allComponentData || (documents ?
            utils.getCachedWorkspaceComponents(documents) :
            utils.getAllAvailableComponents(document));
        if (Object.keys(componentData).length === 0) {
            return [];
        }
        const validator = new DiagnosticsValidator();
        const parsedComponents = utils.parseDocument(document);
        const parsedConfigBlocks = utils.parseConfigBlocks(document);
        const diagnostics = [];
        // Validate components
        for (const parsedComponent of parsedComponents) {
            // Check if component is available (builtin or declared)
            const componentInfo = componentData[parsedComponent.name];
            // Check if component is unknown (not in our registry and not declared)
            if (!componentInfo) {
                diagnostics.push({
                    severity: node_1.DiagnosticSeverity.Error,
                    range: parsedComponent.range,
                    message: `Unknown component '${parsedComponent.name}'`,
                    source: "alloy-lsp",
                });
                continue; // Skip further validation for unknown components
            }
            // Validate component structure (works for both builtin and declared components)
            const componentStructure = componentInfo.lsp_structure;
            diagnostics.push(...validator.validateComponent(parsedComponent, componentStructure));
        }
        // Validate config blocks
        for (const parsedConfigBlock of parsedConfigBlocks) {
            diagnostics.push(...validator.validateConfigBlock(parsedConfigBlock));
        }
        // Check for duplicate components and config blocks within the document
        diagnostics.push(...validateDuplicatesWithinDocument(parsedComponents, parsedConfigBlocks));
        
        // Validate parameter types against their expected types  
        diagnostics.push(...validator.validateParameterTypes(document));
        
        // Validate unused arguments in declare blocks
        diagnostics.push(...validator.validateUnusedArguments(document));
        
        // Validate component references in expressions - use workspace context if available
        // Use the provided workspaceComponentLabelMap, or create one from opened documents if not provided
        let componentLabelMap = workspaceComponentLabelMap;
        if (!componentLabelMap && documents) {
            componentLabelMap = {};
            for (const doc of documents.all()) {
                const docComponentLabelMap = utils.createComponentLabelMap(doc);
                Object.assign(componentLabelMap, docComponentLabelMap);
            }
        }
        diagnostics.push(...validateComponentReferences(document, componentData, componentLabelMap));
        return diagnostics;
    }
    catch (error) {
        console.error('Error in getDocumentDiagnostics:', error);
        return [];
    }
}
// Removed getAllWorkspaceDocuments - now using workspaceComponentService
async function getWorkspaceDiagnostics(documents, workspaceFolders = [], connection) {
    const diagnostics = [];
    const labelTracker = {};
    const declareTracker = {};
    // Get workspace diagnostics data using the centralized service
    const { allDocuments, componentLabelMap } = await workspaceComponentService_1.workspaceComponentService.getWorkspaceDiagnosticsData(documents, workspaceFolders);
    connection?.console.log(`Processing ${allDocuments.length} total documents for diagnostics`);
    // Use the component label map from the service
    const workspaceComponentLabelMap = componentLabelMap;
    // Get all component data from workspace service for consistent diagnostics
    const allComponentData = await workspaceComponentService_1.workspaceComponentService.getAllWorkspaceComponents(documents, workspaceFolders);
    for (const document of allDocuments) {
        try {
            const parsedComponents = utils.parseDocument(document);
            const parsedConfigBlocks = utils.parseConfigBlocks(document);
            // Track component labels for duplicate detection
            for (const component of parsedComponents) {
                if (component.label) {
                    const key = `${component.name}:${component.label}`;
                    if (!labelTracker[key]) {
                        labelTracker[key] = [];
                    }
                    labelTracker[key].push({
                        uri: document.uri,
                        range: component.range
                    });
                }
            }
            // Track declare blocks for duplicate detection
            for (const configBlock of parsedConfigBlocks) {
                if (configBlock.type === 'declare' && configBlock.label) {
                    const key = `declare:${configBlock.label}`;
                    if (!declareTracker[key]) {
                        declareTracker[key] = [];
                    }
                    declareTracker[key].push({
                        uri: document.uri,
                        range: configBlock.range
                    });
                }
            }
            // Get full document diagnostics with workspace context for each document
            const documentDiagnostics = await getDocumentDiagnostics(document, documents, workspaceComponentLabelMap, allComponentData);
            if (documentDiagnostics.length > 0) {
                diagnostics.push({
                    uri: document.uri,
                    items: documentDiagnostics
                });
            }
        }
        catch (error) {
            console.error(`Error processing document ${document.uri}:`, error);
        }
    }
    // Generate duplicate diagnostics
    const duplicateDiagnostics = {};
    // Component label duplicates
    for (const [key, occurrences] of Object.entries(labelTracker)) {
        if (occurrences.length > 1) {
            const [componentName, label] = key.split(':');
            for (const occurrence of occurrences) {
                if (!duplicateDiagnostics[occurrence.uri]) {
                    duplicateDiagnostics[occurrence.uri] = [];
                }
                duplicateDiagnostics[occurrence.uri].push({
                    severity: node_1.DiagnosticSeverity.Error,
                    range: occurrence.range,
                    message: `Duplicate component label '${label}' for ${componentName}. Component labels must be unique across the workspace.`,
                    source: "alloy-lsp",
                });
            }
        }
    }
    // Declare block duplicates
    for (const [key, occurrences] of Object.entries(declareTracker)) {
        if (occurrences.length > 1) {
            const [, declareName] = key.split(':');
            for (const occurrence of occurrences) {
                if (!duplicateDiagnostics[occurrence.uri]) {
                    duplicateDiagnostics[occurrence.uri] = [];
                }
                duplicateDiagnostics[occurrence.uri].push({
                    severity: node_1.DiagnosticSeverity.Error,
                    range: occurrence.range,
                    message: `Duplicate declare block '${declareName}'. Declare block names must be unique across the workspace.`,
                    source: "alloy-lsp",
                });
            }
        }
    }
    // Add duplicate diagnostics to results
    for (const document of allDocuments) {
        const workspaceDiagnostics = duplicateDiagnostics[document.uri] || [];
        if (workspaceDiagnostics.length > 0) {
            // Check if we already have diagnostics for this URI
            const existingIndex = diagnostics.findIndex(d => d.uri === document.uri);
            if (existingIndex >= 0) {
                diagnostics[existingIndex].items.push(...workspaceDiagnostics);
            }
            else {
                diagnostics.push({
                    uri: document.uri,
                    items: workspaceDiagnostics
                });
            }
        }
    }
    return diagnostics;
}
/**
 * Validate component references in expressions throughout the document
 */
function validateComponentReferences(document, allComponentData, workspaceComponentLabelMap) {
    const diagnostics = [];
    // Get all declared component labels for validation - prefer workspace map if available
    let componentLabelMap;
    if (workspaceComponentLabelMap) {
        componentLabelMap = workspaceComponentLabelMap;
    }
    else {
        // Fallback to single document for backward compatibility
        componentLabelMap = utils.createComponentLabelMap(document);
    }
    // Track component scopes for the current document
    const declareBlocks = utils.parseConfigBlocks(document);
    const scopeMap = {}; // line -> scope name
    // Map declare block line ranges to their scope names
    for (const block of declareBlocks) {
        if (block.type === 'declare' && block.label) {
            for (let line = block.range.start.line; line <= block.range.end.line; line++) {
                scopeMap[line] = block.label;
            }
        }
    }
    // Use the centralized component reference parsing
    const componentMatches = utils.parseComponentReferencesInDocument(document, allComponentData);
    for (const match of componentMatches) {
        if (match.isValidReference) {
            // Check if the component with this label exists
            const key = `${match.componentType}:${match.componentLabel}`;
            const targetComponent = componentLabelMap[key];
            if (!targetComponent) {
                // Component with this label doesn't exist
                const labelStart = match.matchIndex + match.componentType.length + 1; // +1 for the dot
                const labelEnd = labelStart + match.componentLabel.length;
                diagnostics.push({
                    severity: node_1.DiagnosticSeverity.Error,
                    range: node_1.Range.create(node_1.Position.create(match.lineIndex, labelStart), node_1.Position.create(match.lineIndex, labelEnd)),
                    message: `Component '${match.componentType}' with label '${match.componentLabel}' not found`,
                    source: "alloy-lsp",
                });
            }
            else {
                // Component exists, now validate export properties for declared components
                if (match.property && allComponentData[match.componentType]?.isDeclared) {
                    const componentData = allComponentData[match.componentType];
                    const declareBlock = componentData.declareBlock;
                    
                    if (declareBlock && declareBlock.blocks) {
                        // Get all export names from the declare block
                        const exportBlocks = declareBlock.blocks.filter(b => b.name === 'export');
                        const availableExports = exportBlocks.map(exp => exp.label).filter(Boolean);
                        
                        if (availableExports.length > 0 && !availableExports.includes(match.property)) {
                            // Invalid export property
                            const propertyStart = match.matchIndex + match.componentType.length + 1 + match.componentLabel.length + 1; // +1 for each dot
                            const propertyEnd = propertyStart + match.property.length;

                            diagnostics.push({
                                severity: node_1.DiagnosticSeverity.Error,
                                range: node_1.Range.create(
                                    node_1.Position.create(match.lineIndex, propertyStart),
                                    node_1.Position.create(match.lineIndex, propertyEnd)
                                ),
                                message: `Unknown export '${match.property}' for component '${match.componentType}'. Available exports: ${availableExports.join(', ')}`,
                                source: "alloy-lsp",
                            });
                        }
                    }
                }
                
                // Component exists, now check scope compatibility
                const referenceScope = scopeMap[match.lineIndex] || 'root';
                const targetScope = targetComponent.scope || 'root';
                // Cross-scope validation rules:
                // 1. Root scope can only reference root scope components
                // 2. Declare scope components are isolated and cannot reference root scope components  
                // 3. Components inside declare scopes cannot be referenced from outside
                // 4. Different declare scopes cannot reference each other
                if (referenceScope === 'root' && targetScope !== 'root') {
                    // Rule 3: Root scope trying to reference component in declare scope
                    const labelStart = match.matchIndex + match.componentType.length + 1; // +1 for the dot
                    const labelEnd = labelStart + match.componentLabel.length;
                    diagnostics.push({
                        severity: node_1.DiagnosticSeverity.Error,
                        range: node_1.Range.create(node_1.Position.create(match.lineIndex, labelStart), node_1.Position.create(match.lineIndex, labelEnd)),
                        message: `Cannot reference component '${match.componentType}.${match.componentLabel}' from root scope. Component is defined inside declare block '${targetScope}'`,
                        source: "alloy-lsp",
                    });
                }
                else if (referenceScope !== 'root' && targetScope === 'root') {
                    // Rule 2: Declare scope trying to reference root scope component
                    const labelStart = match.matchIndex + match.componentType.length + 1; // +1 for the dot
                    const labelEnd = labelStart + match.componentLabel.length;
                    diagnostics.push({
                        severity: node_1.DiagnosticSeverity.Error,
                        range: node_1.Range.create(node_1.Position.create(match.lineIndex, labelStart), node_1.Position.create(match.lineIndex, labelEnd)),
                        message: `Cannot reference component '${match.componentType}.${match.componentLabel}' from declare block '${referenceScope}'. Component is defined in root scope and not accessible from declare blocks`,
                        source: "alloy-lsp",
                    });
                }
                else if (referenceScope !== 'root' && targetScope !== 'root' && referenceScope !== targetScope) {
                    // Rule 4: Different declare scopes trying to reference each other
                    const labelStart = match.matchIndex + match.componentType.length + 1; // +1 for the dot
                    const labelEnd = labelStart + match.componentLabel.length;
                    diagnostics.push({
                        severity: node_1.DiagnosticSeverity.Error,
                        range: node_1.Range.create(node_1.Position.create(match.lineIndex, labelStart), node_1.Position.create(match.lineIndex, labelEnd)),
                        message: `Cannot reference component '${match.componentType}.${match.componentLabel}' from declare block '${referenceScope}'. Component is defined in different declare block '${targetScope}'`,
                        source: "alloy-lsp",
                    });
                }
            }
        }
        else {
            // Could not parse as a valid component reference - check for unknown component types
            const parts = match.matchedText.split('.');
            if (parts.length >= 3) {
                // Check if any substring of the reference is a known component type
                let foundKnownComponent = false;
                for (let i = 1; i < Math.min(parts.length - 1, 4); i++) {
                    const testType = parts.slice(0, i + 1).join('.');
                    if (allComponentData[testType]) {
                        foundKnownComponent = true;
                        break;
                    }
                }
                if (!foundKnownComponent) {
                    // No known component type found in this reference
                    // Report the first part as unknown
                    const possibleType = parts.slice(0, Math.min(3, parts.length - 1)).join('.');
                    const typeEnd = match.matchIndex + possibleType.length;
                    diagnostics.push({
                        severity: node_1.DiagnosticSeverity.Error,
                        range: node_1.Range.create(node_1.Position.create(match.lineIndex, match.matchIndex), node_1.Position.create(match.lineIndex, typeEnd)),
                        message: `Unknown component type '${possibleType}'`,
                        source: "alloy-lsp",
                    });
                }
            }
        }
    }
    return diagnostics;
}
