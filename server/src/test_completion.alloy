declare "nginx" {
  argument "nginx_log_path" { }
  argument "prometheus_remote_write" { }
  argument "loki_write" { }
  argument "environment" { }
  argument "customer" { }

  local.file_match "logs_nginx" {
    path_targets      = [{"__path__" = argument.nginx_log_path.value}]
    ignore_older_than = "336h"
  }

  loki.source.file "logs_scraper_nginx" {
    targets       = local.file_match.logs_nginx.targets
    tail_from_end = true
    forward_to    = [argument.loki_write.value]
  }
}

local.file_match "test_component" {
  path_targets = ["test"]
}

local.file_match "another_component" {
  path_targets = ["another"]
}

prometheus.scrape "test_scrape" {
  targets = local.file_match.test_component.targets
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://localhost:9090/api/v1/write"
  }
}

otelcol.processor.transform "metrics" {
  error_mode = "ignore"
  
  metric_statements {
    context = "metric"
    statements = [
      "set(description, \"test\") where name == \"test_metric\"",
    ]
  }
  
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// Test cases for completion:
